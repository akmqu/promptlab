# Backend used by Next.js rewrites (server-side). Prefer 127.0.0.1 or localhost.
BACKEND_URL=http://127.0.0.1:8000

# Leave unset so the browser calls same-origin /api (cookie works).
# Only set this if you must talk to the API directly AND use the same hostname
# as the frontend (e.g. both localhost, not localhost + 127.0.0.1).
# NEXT_PUBLIC_API_URL=
